func is_prime(n) {
    if n < 2 {
        return false
    }
    i = 2
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 1
    }
    return true
}

# Print all primes up to 50
i = 2
while i <= 50 {
    if is_prime(i) {
        print(i)
    }
    i = i + 1
}